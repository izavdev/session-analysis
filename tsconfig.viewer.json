{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": [],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/web/app.ts"
  ]
}
